# ─── Server ───
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_generator?schema=public

# ─── JWT ───
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7

# ─── Bcrypt ───
BCRYPT_SALT_ROUNDS=10

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Email (nodemailer) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@invoicegen.com

# ─── PDF ───
PDF_OUTPUT_DIR=./tmp
